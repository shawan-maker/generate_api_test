    "dialog_modal": {
      "description": "对话框/模态框定位与操作",
      "selectors": {
        "container": ".el-dialog, .el-message-box",
        "close_button": ".el-dialog__close, .el-message-box__close",
        "submit_button": ".el-dialog__footer button.el-button--primary",
        "cancel_button": ".el-dialog__footer button.el-button--default",
        "title": ".el-dialog__title"
