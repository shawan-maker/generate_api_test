  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-08-27",
      "module": "用户管理",
      "changes": "初始版本：从 Phase 1-3 提取的 UI 选择器经验"
    }
  ],
  "patterns": {
    "table_row_selectors": {
      "description": "Element UI 表格行选择器（含固定列）",
      "selectors": [
        {
          "name": "main",
          "selector": ".el-table__body-wrapper tbody tr",
          "priority": 1,
          "description": "主表格区域（非固定列）"
        },
        {
          "name": "fixed_left",
          "selector": ".el-table__fixed .el-table__fixed-body-wrapper tbody tr",
          "priority": 2,
          "description": "左侧固定列"
        },
        {
          "name": "fixed_right",
          "selector": ".el-table__fixed-right .el-table__fixed-body-wrapper tbody tr",
          "priority": 3,
          "description": "右侧固定列（通常包含操作按钮）"
        }
      ],
      "module_source": ["用户管理"],
      "confidence": 0.95,
      "usage_count": 3,
      "last_verified": "2026-08-27",
      "status": "active"
    },
    "table_action_button": {
      "description": "行操作按钮定位（固定右列优先）",
      "fallback_chain": [
        {
          "strategy": "fixed_right",
          "xpath": "//div[contains(@class,'el-table__fixed-right')]//tbody/tr[{row_index}]//span[contains(.,'{label}')]",
          "priority": 1
        },
        {
          "strategy": "fixed_body_wrapper",
          "xpath": "//div[contains(@class,'el-table__fixed-body-wrapper')]//tbody/tr[{row_index}]//span[contains(.,'{label}')]",
          "priority": 2
        },
        {
          "strategy": "body_wrapper",
          "xpath": "//div[contains(@class,'el-table__body-wrapper')]//tbody/tr[{row_index}]//span[contains(.,'{label}')]",
          "priority": 3
        }
      ],
      "xpath_templates": "@base_nav_kb.json#/composite/table-action-button",
      "module_source": ["用户管理"],
      "confidence": 0.90,
      "usage_count": 5,
      "last_verified": "2026-08-27",
      "status": "active"
    },
    "more_dropdown_trigger": {
      "description": "更多下拉菜单触发器",
      "selectors": [
        {
          "type": "css",
          "selector": ".el-dropdown",
          "priority": 1
        },
        {
          "type": "css",
          "selector": "[class*='dropdown']",
          "priority": 2
        },
        {
          "type": "text",
          "selector": "button:has-text('更多')",
          "priority": 3
        }
      ],
      "click_method": "native_el_click",
      "note": "el-dropdown-selfdefine 只响应原生 el.click()",
      "module_source": ["用户管理"],
      "confidence": 1.0,
      "usage_count": 8,
      "last_verified": "2026-08-27",
      "status": "active"
    },
